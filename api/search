:"text","url":"/docs/shell/services/soundfx#profile-operations","content":"qs ipc call n0ctos-soundfx createProfile gaming '{\"enabled\":true,\"sounds\":{}}'"},"15376":{"id":"section::docs/shell::/docs/shell/services/soundfx-280","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-operations","content":"true when created"},"15377":{"id":"section::docs/shell::/docs/shell/services/soundfx-281","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-operations","content":"qs ipc call n0ctos-soundfx getProfile gaming"},"15378":{"id":"section::docs/shell::/docs/shell/services/soundfx-282","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-operations","content":"profile JSON, or \"null\""},"15379":{"id":"section::docs/shell::/docs/shell/services/soundfx-283","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-operations","content":"qs ipc call n0ctos-soundfx renameProfile gaming work"},"15380":{"id":"section::docs/shell::/docs/shell/services/soundfx-284","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-operations","content":"true when renamed"},"15381":{"id":"section::docs/shell::/docs/shell/services/soundfx-285","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-operations","content":"qs ipc call n0ctos-soundfx selectProfile gaming"},"15382":{"id":"section::docs/shell::/docs/shell/services/soundfx-286","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-operations","content":"true when selected"},"15383":{"id":"section::docs/shell::/docs/shell/services/soundfx-287","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-operations","content":"qs ipc call n0ctos-soundfx removeProfile gaming"},"15384":{"id":"section::docs/shell::/docs/shell/services/soundfx-288","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-operations","content":"true when removed"},"15385":{"id":"section::docs/shell::/docs/shell/services/soundfx-289","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#master-volume-operations","content":"How to call"},"15386":{"id":"section::docs/shell::/docs/shell/services/soundfx-290","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#master-volume-operations","content":"What does it do"},"15387":{"id":"section::docs/shell::/docs/shell/services/soundfx-291","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#master-volume-operations","content":"setMasterVolume <value>"},"15388":{"id":"section::docs/shell::/docs/shell/services/soundfx-292","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#master-volume-operations","content":"Stores the master volume with no clamp. Returns false for non-finite input."},"15389":{"id":"section::docs/shell::/docs/shell/services/soundfx-293","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#master-volume-operations","content":"Example"},"15390":{"id":"section::docs/shell::/docs/shell/services/soundfx-294","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#master-volume-operations","content":"Result"},"15391":{"id":"section::docs/shell::/docs/shell/services/soundfx-295","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#master-volume-operations","content":"qs ipc call n0ctos-soundfx setMasterVolume 0.5"},"15392":{"id":"section::docs/shell::/docs/shell/services/soundfx-296","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#master-volume-operations","content":"true, master becomes 0.5"},"15393":{"id":"section::docs/shell::/docs/shell/services/soundfx-297","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#single-entry-point-for-ui-sounds","content":"All sound effects go through:"},"15394":{"id":"section::docs/shell::/docs/shell/services/soundfx-298","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#single-entry-point-for-ui-sounds","content":"instead of each button, popup, or OSD creating its own:"},"15395":{"id":"section::docs/shell::/docs/shell/services/soundfx-299","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-based-sound-sets","content":"Each profile owns an independent sound table:"},"15396":{"id":"section::docs/shell::/docs/shell/services/soundfx-300","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-based-sound-sets","content":"Switching profiles switches the whole audible personality at once:"},"15397":{"id":"section::docs/shell::/docs/shell/services/soundfx-301","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-based-sound-sets","content":"selectProfile() stops all voices when the profile actually changes, so sounds from the old profile never bleed into the new one."},"15398":{"id":"section::docs/shell::/docs/shell/services/soundfx-302","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profilesdefault-auto-creation","content":"On startup, when Config.isReady and no default profile exists:"},"15399":{"id":"section::docs/shell::/docs/shell/services/soundfx-303","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profilesdefault-auto-creation","content":"default is the permanent fallback:"},"15400":{"id":"section::docs/shell::/docs/shell/services/soundfx-304","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#target-string-resolution","content":"Callers use short sound names:"},"15401":{"id":"section::docs/shell::/docs/shell/services/soundfx-305","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#target-string-resolution","content":"_parseTarget() normalizes:"},"15402":{"id":"section::docs/shell::/docs/shell/services/soundfx-306","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#target-string-resolution","content":"_splitTargetPath() splits on the first . only, so:"},"15403":{"id":"section::docs/shell::/docs/shell/services/soundfx-307","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#target-string-resolution","content":"Nested property reads use _deepGet() with . splitting, so deeper paths also resolve."},"15404":{"id":"section::docs/shell::/docs/shell/services/soundfx-308","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#target-string-resolution","content":"When no explicit profile is given, _profileName() uses the active soundfx.profile (trimmed, default \"default\")."},"15405":{"id":"section::docs/shell::/docs/shell/services/soundfx-309","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#definition-normalization","content":"_definition(name) converts the raw config object into playback-ready data:"},"15406":{"id":"section::docs/shell::/docs/shell/services/soundfx-310","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#definition-normalization","content":"A definition that is missing, disabled, or has an empty path never produces a voice. Both play() and loop() check this before allocating."},"15407":{"id":"section::docs/shell::/docs/shell/services/soundfx-311","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#one-shot-overlap","content":"One-shots are allowed to overlap:"},"15408":{"id":"section::docs/shell::/docs/shell/services/soundfx-312","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#one-shot-overlap","content":"A busy preloaded voice is never stolen mid-playback; a fresh temporary voice is created instead. This is why rapid clicking produces overlapping clicks rather than cut-off audio."},"15409":{"id":"section::docs/shell::/docs/shell/services/soundfx-313","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#exactly-one-loop-per-sound","content":"Loops enforce a singleton voice:"},"15410":{"id":"section::docs/shell::/docs/shell/services/soundfx-314","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#exactly-one-loop-per-sound","content":"Calling loop() twice does not stack two ambient layers."},"15411":{"id":"section::docs/shell::/docs/shell/services/soundfx-315","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#voice-lifecycle-mediaplayer--audiooutput--releasetimer","content":"Every voice is:"},"15412":{"id":"section::docs/shell::/docs/shell/services/soundfx-316","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#voice-lifecycle-mediaplayer--audiooutput--releasetimer","content":"The volume binding is live:"},"15413":{"id":"section::docs/shell::/docs/shell/services/soundfx-317","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#voice-lifecycle-mediaplayer--audiooutput--releasetimer","content":"so changing masterVolume affects already-loaded voices without reconfiguration."},"15414":{"id":"section::docs/shell::/docs/shell/services/soundfx-318","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#voice-lifecycle-mediaplayer--audiooutput--releasetimer","content":"Idle voices linger for one second:"},"15415":{"id":"section::docs/shell::/docs/shell/services/soundfx-319","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#voice-lifecycle-mediaplayer--audiooutput--releasetimer","content":"Preloaded (keepLoaded) voices skip the timer and stay resident until the definition changes, preload is disabled, or the sound disappears."},"15416":{"id":"section::docs/shell::/docs/shell/services/soundfx-320","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#preload-reconciliation","content":"Every Config.revision change (while Config.isReady) runs _reconcile():"},"15417":{"id":"section::docs/shell::/docs/shell/services/soundfx-321","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#preload-reconciliation","content":"enabled always wins over preload: a disabled sound is never preloaded, even with preload: true."},"15418":{"id":"section::docs/shell::/docs/shell/services/soundfx-322","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#reactive-configuration","content":"profile, isEnabled, and masterVolume are bindings over Config.revision:"},"15419":{"id":"section::docs/shell::/docs/shell/services/soundfx-323","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#reactive-configuration","content":"External config edits (file, IPC, another component) propagate without an explicit reload call. _reconcile() also runs on onRevisionChanged so voices track the new definitions."},"15420":{"id":"section::docs/shell::/docs/shell/services/soundfx-324","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#change-signals","content":"Imperative consumers (OSDs, debug overlays, logging) use:"},"15421":{"id":"section::docs/shell::/docs/shell/services/soundfx-325","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#change-signals","content":"Reactive bindings (profile text, volume sliders, looping indicators) do not need these signals."},"15422":{"id":"section::docs/shell::/docs/shell/services/soundfx-326","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#config-integration","content":"The service does not implement its own JSON persistence. All state lives in:"},"15423":{"id":"section::docs/shell::/docs/shell/services/soundfx-327","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#config-integration","content":"inside:"},"15424":{"id":"section::docs/shell::/docs/shell/services/soundfx-328","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#config-integration","content":"via Config.get() / Config.set() / Config.remove() / Config.has()."},"15425":{"id":"section::docs/shell::/docs/shell/services/soundfx-329","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#json-serialization-for-ipc","content":"getStatus() returns a plain object that is JSON.stringify()-ed by IPC. getSFX() / getProfile() results are likewise stringified (\"null\" when missing), so terminal scripts receive valid JSON."},"15426":{"id":"section::docs/shell::/docs/shell/services/soundfx-330","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#no-01-clamp-on-master-volume","content":"setMasterVolume() retains the value exactly:"},"15427":{"id":"section::docs/shell::/docs/shell/services/soundfx-331","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#no-01-clamp-on-master-volume","content":"Qt's AudioOutput applies its own final playback range. The service intentionally does not cap, mirroring the stored value in getMasterVolume() / masterVolume."},"15428":{"id":"section::docs/shell::/docs/shell/services/soundfx-332","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#no-01-clamp-on-master-volume","content":"Non-finite input (NaN, Infinity, non-numeric strings) returns false and stores nothing. Reads of a missing/non-numeric stored value fall back to 1.0."},"15429":{"id":"section::docs/shell::/docs/shell/services/soundfx-333","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#one-shots-cannot-be-stopped","content":"There is no stopOneShot():"},"15430":{"id":"section::docs/shell::/docs/shell/services/soundfx-334","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#one-shots-cannot-be-stopped","content":"stop() only resolves _findLoopVoice(). A one-shot, once started, plays to completion (or until a profile switch / disable destroys its voice)."},"15431":{"id":"section::docs/shell::/docs/shell/services/soundfx-335","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-names-are-trimmed-strings","content":"_cleanProfileName() trims whitespace. Empty-after-trim names are rejected by every profile function. Profile names are case-sensitive and must be valid Config path segments (no dots — a dot would create a nested config path)."},"15432":{"id":"section::docs/shell::/docs/shell/services/soundfx-336","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#createprofile-requires-an-object","content":"Arrays, strings, numbers, null, and undefined return false. Existing profiles are never overwritten — use setSFX() with a {name, profile} target or Config.set() to edit an existing profile."},"15433":{"id":"section::docs/shell::/docs/shell/services/soundfx-337","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#renameprofile-copies-then-deletes","content":"Rename is not atomic at the config level:"},"15434":{"id":"section::docs/shell::/docs/shell/services/soundfx-338","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#renameprofile-copies-then-deletes","content":"Renaming to an existing name, renaming a missing source, or renaming with empty/same names all return false."},"15435":{"id":"section::docs/shell::/docs/shell/services/soundfx-339","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#profile-switching-destroys-voices","content":"selectProfile() to a different profile calls _stopAllVoices() before switching. Both one-shots and loops are destroyed, not faded. removeProfile() of the active profile does the same while resetting to \"default\"."},"15436":{"id":"section::docs/shell::/docs/shell/services/soundfx-340","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#missing-profile-object-means-enabled","content":"When the active profile has no stored object:"},"15437":{"id":"section::docs/shell::/docs/shell/services/soundfx-341","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#missing-profile-object-means-enabled","content":"A profile only disables playback when its stored enabled field is explicitly false. This keeps fresh installs audible before any profile object exists."},"15438":{"id":"section::docs/shell::/docs/shell/services/soundfx-342","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#sound-level-enabled-overrides-everything","content":"A sound with enabled: false is never played, looped, or preloaded, regardless of profile enabled or preload flags. configure() and start() both re-check this."},"15439":{"id":"section::docs/shell::/docs/shell/services/soundfx-343","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#ipc-json-must-be-valid","content":"setSFX / createProfile IPC parse <json> with JSON.parse() and return false on failure with a [SoundFX] warning. String sound values must therefore be JSON-quoted:"},"15440":{"id":"section::docs/shell::/docs/shell/services/soundfx-344","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#no-per-voice-volume-ipc","content":"There is no setVolume <name> <value> IPC. Per-sound volume is config state — write it via setSFX <name>.volume <json-number> and the live AudioOutput.volume binding picks it up."},"15441":{"id":"section::docs/shell::/docs/shell/services/soundfx-345","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#51-click-sounds-on-buttons","content":"The most common usage — one line per interaction:"},"15442":{"id":"section::docs/shell::/docs/shell/services/soundfx-346","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#51-click-sounds-on-buttons","content":"When the profile is disabled or the sound has no path, play() returns false and the click handling still runs — audio never blocks UI logic."},"15443":{"id":"section::docs/shell::/docs/shell/services/soundfx-347","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#52-a-mute--enable-toggle","content":"Bind to the reactive isEnabled state:"},"15444":{"id":"section::docs/shell::/docs/shell/services/soundfx-348","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#52-a-mute--enable-toggle","content":"In practice, toggling the profile flag is a config write on the profile object:"},"15445":{"id":"section::docs/shell::/docs/shell/services/soundfx-349","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#52-a-mute--enable-toggle","content":"The service picks it up via Config.revision and _reconcile() releases voices when disabled."},"15446":{"id":"section::docs/shell::/docs/shell/services/soundfx-350","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#52-a-mute--enable-toggle","content":"From IPC, disable one sound without touching the profile:"},"15447":{"id":"section::docs/shell::/docs/shell/services/soundfx-351","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#53-master-volume-slider","content":"Because there is no clamp, allow amplification above 1.0 when desired:"},"15448":{"id":"section::docs/shell::/docs/shell/services/soundfx-352","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#53-master-volume-slider","content":"Read back:"},"15449":{"id":"section::docs/shell::/docs/shell/services/soundfx-353","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/soundfx#53-master-volume-slider","content":"From IPC:"},"15450":{"id":"section::docs/shell::/docs/shell/services/soundfx-354","page_id":"section::docs/shell::/docs/shell/services/soundfx","tags":["docs/shell"],"type":"text",