gstore-285","page_id":"section::docs/shell::/docs/shell/services/configstore","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/configstore#path-registry","content":"Changes the physical path of an existing non-default key, discards its old document, resets state/history/baseline, resets the controller's directory/write flags, and force-reloads the new file. Rejects homeConfig, unregistered keys, empty paths, active write pipelines / dirty-write state, and duplicate physical paths. Same-path updates are a true no-op."},"8590":{"id":"section::docs/shell::/docs/shell/services/configstore-286","page_id":"section::docs/shell::/docs/shell/services/configstore","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/configstore#path-registry","content":"ConfigStore.removePath(fileKey)"},"8591":{"id":"section::docs/shell::/docs/shell/services/configstore-287","page_id":"section::docs/shell::/docs/shell/services/configstore","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/configstore#path-registry","content":"Removes a non-default key plus its document, state, history, baseline, and (via pathKeys) its controller. Leaves the physical file untouched. Rejects homeConfig, unregistered keys, and active write pipelines / dirty-write state."},"8592":{"id":"section::docs/shell::/docs/shell/services/configstore-288","page_id":"section::docs/shell::/docs/shell/services/configstore","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/configstore#path-registry","content":"Example"},"8593":{"id":"section::docs/shell::/docs/shell/services/configstore-289","page_id":"section::docs/shell::/docs/shell/services/configstore","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/configstore#path-registry","content":"Result"},"8594":{"id":"section::docs/shell::/docs/shell/services/configstore-290","page_id":"section::docs/shell::/docs/shell/services/configstore","tags":["docs/shell"],"type":"text","url":"/docs/shell/services/configstor